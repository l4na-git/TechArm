# --- Ollama (LLM via Tailscale) ---
OLLAMA_BASE_URL=http://100.xxx.xxx.xxx:11434
OLLAMA_MODEL=teacharm-llm

# --- VOICEVOX Engine (self-hosted, via Tailscale) ---
VOICEVOX_BASE_URL=http://100.xxx.xxx.xxx:50021

# Speaker selection by name (recommended)
VOICEVOX_SPEAKER_NAME=春日部つむぎ
VOICEVOX_STYLE_NAME=ノーマル

# Voice params (Engine audio_query JSON overrides)
VOICEVOX_SPEED_SCALE=1.05
VOICEVOX_PITCH_SCALE=0.00
VOICEVOX_INTONATION_SCALE=1.10
VOICEVOX_VOLUME_SCALE=1.00
VOICEVOX_PRE_PHONEME_LENGTH=0.10
VOICEVOX_POST_PHONEME_LENGTH=0.10

# --- Control Panel (Tailscale only) ---
CONTROL_PANEL_URL=http://100.xxx.xxx.xxx:3000
