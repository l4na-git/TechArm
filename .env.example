# =============================================================================
# TeachArm 環境変数設定ファイル（Example / Template）
# =============================================================================
# このファイルはリポジトリに含まれます。
# デプロイ時にGitHub Secretsの値と組み合わせて .env を生成します。
#
# 使い方:
# 1) .env.example を .env にコピー
# 2) 非機密の値はこのファイルの値を利用
# 3) 機密値はGitHub Secretsまたは手元で .env に設定
#
# -----------------------------------------------------------------------------
# Required GitHub Secrets (Actions)
# -----------------------------------------------------------------------------
# ENV_OLLAMA_BASE_URL
# ENV_OLLAMA_MODEL
# ENV_VOICEVOX_BASE_URL
# ENV_VISION_OFFLOAD_URL
# ENV_CONTROL_PANEL_URL
# ENV_SO101_PORT
#
# 注意:
# - このファイルには機密の実値を置かないでください。
# - GitHub Actionsでは .env.example から .env を作り、Secretsを追記します。
# - Secretsで値を入れる項目は下記セクションで空欄にしています。
# =============================================================================

# --- LLM (Ollama/DeepSeek) ---
# 文章生成専用。必要時のみ呼び出す。
# Secrets: ENV_OLLAMA_BASE_URL -> OLLAMA_BASE_URL
# Secrets: ENV_OLLAMA_MODEL -> OLLAMA_MODEL
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- VOICEVOX Engine (self-hosted, via Tailscale) ---
# Secrets: ENV_VOICEVOX_BASE_URL -> VOICEVOX_BASE_URL
VOICEVOX_BASE_URL=

# Speaker selection by name (recommended)
# Non-secret defaults
VOICEVOX_SPEAKER_NAME=春日部つむぎ
VOICEVOX_STYLE_NAME=ノーマル

# Voice params (Engine audio_query JSON overrides)
VOICEVOX_SPEED_SCALE=1.05
VOICEVOX_PITCH_SCALE=0.00
VOICEVOX_INTONATION_SCALE=1.10
VOICEVOX_VOLUME_SCALE=1.00
VOICEVOX_PRE_PHONEME_LENGTH=0.10
VOICEVOX_POST_PHONEME_LENGTH=0.10

# --- Vision Offload (optional, via Tailscale) ---
# Secrets: ENV_VISION_OFFLOAD_URL -> VISION_OFFLOAD_URL
VISION_OFFLOAD_URL=

# --- Control Panel (Tailscale only) ---
# Secrets: ENV_CONTROL_PANEL_URL -> CONTROL_PANEL_URL
CONTROL_PANEL_URL=
# Non-secret defaults
CONTROL_PANEL_HOST=127.0.0.1

# --- ASR (faster-whisper) ---
ASR_MODEL=base
ASR_LANGUAGE=ja
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1

# --- SO-101 Robot Arm ---
# USB serial port for SO-101 Follower arm
# Use `lerobot-find-port` to discover the correct port
# macOS: /dev/tty.usbmodem*
# Linux: /dev/ttyUSB* or /dev/ttyACM*
# Secrets: ENV_SO101_PORT -> SO101_PORT
SO101_PORT=
SO101_BAUDRATE=1000000
